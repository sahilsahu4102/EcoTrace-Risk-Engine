# Scrapingdog API Key (for CSR page scraping)
# Get yours at: https://scrapingdog.com
SCRAPINGDOG_API_KEY=your_scrapingdog_api_key_here

# Global Forest Watch API Key (for tree cover loss data)
# Register free at: https://www.globalforestwatch.org/my-gfw/
GFW_API_KEY=your_gfw_api_key_here

# OpenRouter API Key (for LLM context extraction)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# ── Production Data Download ───────────────────────────────────
# Set these URLs to auto-download data on container startup.
# Supports: direct links, Google Drive share links, Dropbox links
# Accepted formats: .zip, .tar.gz, or single .csv

# Trase supply chain data (ZIP of CSVs)
# Upload your data/trase/ folder as a ZIP to cloud storage and paste the link:
TRASE_DATA_URL=

# Forest 500 company rankings (ZIP or single CSV)
# Upload your data/forest500/ folder as a ZIP to cloud storage and paste the link:
FOREST500_DATA_URL=
